{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"M6.1-B JudgeResponse v1 (synthetic stage contract)",
  "type":"object",
  "additionalProperties":false,
  "required":["request_id","trial_id","verdicts","rationale_codes","usage","provider","finish_reason"],
  "properties":{
    "request_id":{"type":"string","minLength":1},
    "trial_id":{"type":"string","minLength":1},
    "verdicts":{"type":"object","additionalProperties":{"type":"string","enum":["PASS","FAIL","UNKNOWN","UNSCORABLE"]}},
    "rationale_codes":{"type":"object","additionalProperties":{"type":"string"}},
    "usage":{"type":"object","additionalProperties":false,"required":["prompt_tokens","completion_tokens"],"properties":{"prompt_tokens":{"type":["integer","null"],"minimum":0},"completion_tokens":{"type":["integer","null"],"minimum":0}}},
    "provider":{"const":"SYNTHETIC_STUB"},
    "finish_reason":{"type":"string","minLength":1}
  }
}
