DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
SHOPRELAY_DB=data/shoprelay.sqlite3
SHOPRELAY_INDEX=data/index.json
QDRANT_URL=
SHOPRELAY_QDRANT_MODE=local
DATABASE_URL=
SHOPRELAY_RETRIEVAL_MODE=bm25
SHOPRELAY_RETRIEVAL_CONFIG_VERSION=m2-r-v1
SHOPRELAY_RETRIEVAL_SPARSE_TOP_K=5
SHOPRELAY_RETRIEVAL_DENSE_TOP_K=5
SHOPRELAY_RETRIEVAL_OUTPUT_TOP_K=5
SHOPRELAY_RETRIEVAL_RRF_CONSTANT=60
SHOPRELAY_RETRIEVAL_RERANK_CANDIDATE_LIMIT=10
SHOPRELAY_RETRIEVAL_TIMEOUT_SECONDS=8
SHOPRELAY_RETRIEVAL_MIN_COSINE_SCORE=0.20
SHOPRELAY_MAX_MODEL_REQUESTS=12
SHOPRELAY_MAX_MODEL_TOKENS_PER_CHAT=12288
SHOPRELAY_MAX_RETRIEVAL_HOPS=3
SHOPRELAY_MAX_RETRIEVAL_QUERIES=6
SHOPRELAY_MAX_RETRIEVAL_QUERIES_PER_HOP=2
SHOPRELAY_MAX_ESTIMATED_COST_USD_PER_CHAT=0.10
SHOPRELAY_MAX_CHAT_WALL_SECONDS=105
SHOPRELAY_ALLOWED_ORIGINS=
SHOPRELAY_COOKIE_SECURE=false
# Server-side orchestration. LangGraph mode requires the explicit checkpoint setup command.
SHOPRELAY_ORCHESTRATOR=legacy
SHOPRELAY_LANGGRAPH_CHECKPOINT_SCHEMA=shoprelay_langgraph
SHOPRELAY_GRAPH_VERSION=g2
SHOPRELAY_EXECUTION_VERSION=g2-api-v1
# Isolated M3.1 Supervisor skeleton. Requires explicit LangGraph mode; default off.
SHOPRELAY_M3_SUPERVISOR_ENABLED=false
# Empty means metrics access is disabled for all demo users.
SHOPRELAY_OBSERVABILITY_ADMIN_USER_IDS=
# Local development fallback. Keep real credentials only in ignored .env.m0.local.
SHOPRELAY_POSTGRES_PASSWORD=

# M0 implemented DeepSeek node: single-agent policy answer.
SHOPRELAY_DEEPSEEK_POLICY_ANSWER_THINKING=disabled
SHOPRELAY_DEEPSEEK_POLICY_ANSWER_MAX_TOKENS=512
SHOPRELAY_DEEPSEEK_POLICY_ANSWER_TIMEOUT_SECONDS=20
SHOPRELAY_DEEPSEEK_POLICY_ANSWER_MAX_COST_USD=0.10

# Historical M2.3 Self-RAG nodes; retained for replay and offline experiments.
SHOPRELAY_DEEPSEEK_CONDITION_EXTRACTION_THINKING=disabled
SHOPRELAY_DEEPSEEK_CONDITION_EXTRACTION_MAX_TOKENS=768
SHOPRELAY_DEEPSEEK_CONDITION_EXTRACTION_TIMEOUT_SECONDS=20
SHOPRELAY_DEEPSEEK_CONDITION_EXTRACTION_MAX_COST_USD=0.02
SHOPRELAY_DEEPSEEK_EVIDENCE_SUFFICIENCY_THINKING=disabled
SHOPRELAY_DEEPSEEK_EVIDENCE_SUFFICIENCY_MAX_TOKENS=2048
SHOPRELAY_DEEPSEEK_EVIDENCE_SUFFICIENCY_TIMEOUT_SECONDS=30
SHOPRELAY_DEEPSEEK_EVIDENCE_SUFFICIENCY_MAX_COST_USD=0.03

# M2-R bounded MULTI retrieval planning; policy rules are derived after retrieval.
SHOPRELAY_DEEPSEEK_POLICY_ASPECT_PLANNING_THINKING=disabled
SHOPRELAY_DEEPSEEK_POLICY_ASPECT_PLANNING_MAX_TOKENS=512
SHOPRELAY_DEEPSEEK_POLICY_ASPECT_PLANNING_TIMEOUT_SECONDS=15
SHOPRELAY_DEEPSEEK_POLICY_ASPECT_PLANNING_MAX_COST_USD=0.02

# M2.1 safety-first route classifier; deterministic rules handle clear requests.
SHOPRELAY_DEEPSEEK_ROUTE_THINKING=disabled
SHOPRELAY_DEEPSEEK_ROUTE_MAX_TOKENS=384
SHOPRELAY_DEEPSEEK_ROUTE_TIMEOUT_SECONDS=10
SHOPRELAY_DEEPSEEK_ROUTE_MAX_COST_USD=0.01

# Diagnostic probes only; these are not production router/planner nodes.
SHOPRELAY_DEEPSEEK_ROUTE_DIAGNOSTIC_THINKING=disabled
SHOPRELAY_DEEPSEEK_ROUTE_DIAGNOSTIC_MAX_TOKENS=768
SHOPRELAY_DEEPSEEK_ROUTE_DIAGNOSTIC_TIMEOUT_SECONDS=40
SHOPRELAY_DEEPSEEK_ROUTE_DIAGNOSTIC_MAX_COST_USD=0.01
SHOPRELAY_DEEPSEEK_PLANNING_DIAGNOSTIC_THINKING=disabled
SHOPRELAY_DEEPSEEK_PLANNING_DIAGNOSTIC_MAX_TOKENS=1536
SHOPRELAY_DEEPSEEK_PLANNING_DIAGNOSTIC_TIMEOUT_SECONDS=40
SHOPRELAY_DEEPSEEK_PLANNING_DIAGNOSTIC_MAX_COST_USD=0.03
SHOPRELAY_DEEPSEEK_EVIDENCE_SUFFICIENCY_DIAGNOSTIC_THINKING=enabled
SHOPRELAY_DEEPSEEK_EVIDENCE_SUFFICIENCY_DIAGNOSTIC_MAX_TOKENS=768
SHOPRELAY_DEEPSEEK_EVIDENCE_SUFFICIENCY_DIAGNOSTIC_TIMEOUT_SECONDS=40
SHOPRELAY_DEEPSEEK_EVIDENCE_SUFFICIENCY_DIAGNOSTIC_MAX_COST_USD=0.02
